# Optional overrides for mcp/servers.json placeholders.
#
# Copy to mcp/.env and edit only the lines you need.
# The script also reads real environment variables; either works.
#
# Default if unset: $HOME/development/codebases/tools/jv-linear-mcp
JV_LINEAR_MCP_DIR=$HOME/development/codebases/tools/jv-linear-mcp
